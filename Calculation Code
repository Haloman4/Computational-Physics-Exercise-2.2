# Part D
# Technically a geosynchronous satellite is one that orbits the Earth once per sidereal day,
#which is 23.93 hours, not 24 hours. Why is this? And how much difference will it make
#to the altitude of the satellite?

# There is a difference in altitude of about 100 km
# The reason for this difference is because(I don't know the exact answer,
# but I can guess)
# that 24 hours is just an approxiamation that,
# while useful for day-to-day living,
# is technically not exact.

def get_orbit_radius(T_minutes):
    """Calculates total orbital radius (r = R + h) in meters from period in minutes."""
    T_seconds = T_minutes * 60
    r = ((G * M * T_seconds**2) / (4 * np.pi**2))**(1/3)
    return r

def plot_orbit(T_minutes, orbit_name, ax=None):
    """Plots the Earth and a circular satellite orbit on a given axis."""
    if ax is None:
        fig, ax = plt.subplots(figsize=(6, 6))
        
    r_orbit = get_orbit_radius(T_minutes)
    
    # Generate angles from 0 to 2*pi
    theta = np.linspace(0, 2 * np.pi, 200)
    
    # Earth Circle (Convert meters to kilometers for cleaner axis labels)
    x_earth = (R_earth / 1000) * np.cos(theta)
    y_earth = (R_earth / 1000) * np.sin(theta)
    ax.fill(x_earth, y_earth, color='darkorange', alpha=0.8, label='Earth')
    
    # Orbit Circle
    x_orbit = (r_orbit / 1000) * np.cos(theta)
    y_orbit = (r_orbit / 1000) * np.sin(theta)
    ax.plot(x_orbit, y_orbit, color='dodgerblue', linestyle='--', linewidth=2, label=f'Orbit ({orbit_name})')
    
    # Graph Formatting
    ax.set_aspect('equal', 'box') # Keeps the circles perfectly round
    ax.grid(True, linestyle=':', alpha=0.6)
    ax.set_title(f"Orbit for T = {orbit_name}", fontsize=12, fontweight='bold')
    ax.set_xlabel("X Distance (km)")
    ax.set_ylabel("Y Distance (km)")
    ax.legend(loc='upper right')

# Change sizes
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 6))

# Left Plot: Low Earth Orbit (90 Minutes)
plot_orbit(90, "90 Minutes", ax=ax1)

# Right Plot: Geosynchronous Orbit (24 Hours = 1440 Minutes)
plot_orbit(24 * 60, "24 Hours", ax=ax2)

plt.tight_layout()
plt.show()

