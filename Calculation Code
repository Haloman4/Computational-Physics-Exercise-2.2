import sympy as sp
import numpy as np
from sympy import Matrix
import matplotlib.pyplot as plt

#T = sp.Symbol('T')
G = 6.67*10**(-11)
R = 6371*1000
R_earth = 6371 * 1000
M = 5.97*(10**24)
pi = 3.14159
# display(G)
# Part A: For a circular orbit, T = 2pi*sqrt(r^3 / GM). Rearranging for r,
# this gives r = (GMT^2/4pi^2)^1/3. However, this is the distance from the center
# of the body, and the height is the distance from the surface to the orbit, so
# R must be subtracted to account for the difference between the surface and the center


# Part B
# Write a program that asks the user to enter the desired value of T
# and then calculates and
# prints out the correct altitude in meters.
def H():
    T = int(input('Insert the Period T:'))
    h = (((G*M*T**2)/(4*pi**2))**(1/3)) - R
    #display(h)
    display('Height in m:', h)
    t = sp.Symbol('t')
    h_solve = (((G*M*t**2)/(4*pi**2))**(1/3)) - R
    min_h = 0
    min_period_eq = sp.Eq(h_solve, min_h)
    min_period = sp.solve(min_period_eq)
    min_period_minutes = min_period[1] / 60
    display('Extremal Period:', min_period_minutes)

H()


# Part C
# Use your program to calculate the altitudes of satellites that orbit the Earth once a day
# (so-called “geosynchronous” orbit), once every 90 minutes, and once every 45 minutes.
# What do you conclude from the last of these calculations?
def geo_sat():
    T = sp.Symbol('T')
    h = (((G*M*T**2)/(4*pi**2))**(1/3)) - R
    h_90 = sp.lambdify(T, h, 'numpy')
    display('Height for 90-min orbit:', h_90(90*60))
    h_45 = sp.lambdify(T, h, 'numpy')
    display('Height for 45-min orbit:', h_45(45*60))
    h_24 = sp.lambdify(T, h, 'numpy')
    display('Height for 24-hour orbit:', h_24(24*60*60))
    h_23 = sp.lambdify(T, h, 'numpy')
    display('Height for 23.93-hour orbit:', h_23(23.93*60*60))
geo_sat()
# Note: Because of these results, 45 minutes is impossible. However, because
